% referencias/MatEconomistas.bib
%
% NOTA IMPORTANTE (reemplazo de bibliografía, actualizado):
% La bibliografía oficial del programa institucional EC-620 (Universidad
% Fidélitas) exigía textos de acceso pagado/institucional (Martínez
% Estudillo, Samuelson y Nordhaus, Arya y Lardner, Agudelo, Escobar,
% Infante, Ugarte, Vidaurri, Cachanosky). Se reemplazó por decisión del
% usuario con 5 libros de descarga legal y gratuita, para que esta
% materia sea reutilizable en cualquier universidad/periodo sin depender
% de accesos institucionales de Fidélitas. Copias de referencia
% guardadas temporalmente en materias/matematica-economistas/bibliografia/
% (carpeta de trabajo, no permanente).
%
% Cobertura por unidad:
%   Unidad 1 (álgebra lineal)                → kuttler2021 (+ axler2024 opcional)
%   Unidades 2-4 (cálculo, optimización,
%     funciones varias variables)             → stewart2021 (+ buscalc2013 para
%                                                aplicaciones económicas)
%   Unidad 5 (ecuaciones diferenciales)        → trench2013
%   Unidad 6 (ética)                           → sin libro asignado; ninguno de
%                                                los 5 cubre ética/filosofía de
%                                                la matemática — esa sesión se
%                                                construye como contenido y
%                                                preguntas de reflexión propias.

@book{stewart2021,
  title     = {Cálculo: Trascendentes Tempranas},
  author    = {Stewart, James},
  edition   = {9},
  year      = {2021},
  publisher = {Cengage Learning},
  note      = {Edición completa (una variable + varias variables): cap. 14
               Derivadas parciales y cap. 15 Integrales múltiples cubren la
               Unidad 4. Ya en posesión del usuario, no es de acceso abierto
               (uso personal, no se redistribuye).}
}

@book{kuttler2021,
  title     = {A First Course in Linear Algebra},
  author    = {Kuttler, Ken},
  year      = {2021},
  publisher = {LibreTexts / eCampusOntario},
  note      = {Licencia Creative Commons BY. Descarga legal y gratuita.
               Cubre operaciones con matrices y solución de sistemas por
               Gauss-Jordan (Unidad 1).}
}

@book{buscalc2013,
  title     = {Business Calculus},
  author    = {Calaway, Shana and Hoffman, Dale and Lippman, David},
  year      = {2013},
  publisher = {Open Textbook Store},
  note      = {Licencia Creative Commons Attribution 3.0. Descarga legal y
               gratuita. Cubre análisis marginal, elasticidad de la demanda,
               optimización de utilidades/costos, valor presente de flujo de
               efectivo continuo, y funciones de dos variables con derivadas
               parciales — puente cálculo-economía para las Unidades 2, 3 y 4.}
}

@book{trench2013,
  title     = {Elementary Differential Equations},
  author    = {Trench, William F.},
  year      = {2013},
  publisher = {Trinity University (Digital Commons)},
  note      = {Distribución gratuita y legal autorizada por el propio autor.
               Cubre ecuaciones separables, lineales de primer y segundo
               orden, y modelos de crecimiento exponencial/logístico
               (Unidad 5). No cubre por nombre las ecuaciones de Bernoulli
               ni de Ricatti, ni el modelo de telaraña (es de tiempo
               discreto, no diferencial) — esos puntos se desarrollan como
               contenido propio dentro de la sesión correspondiente.}
}

@book{axler2024,
  title     = {Linear Algebra Done Right},
  author    = {Axler, Sheldon},
  edition   = {4},
  year      = {2024},
  publisher = {Springer},
  note      = {Acceso abierto (Springer Undergraduate Texts in Mathematics).
               Referencia secundaria/opcional para profundidad teórica
               (espacios vectoriales, valores propios) — no es el texto
               principal de la Unidad 1 porque evita deliberadamente el
               enfoque computacional (Gauss-Jordan) que pide el programa;
               ese rol lo cubre kuttler2021.}
}
